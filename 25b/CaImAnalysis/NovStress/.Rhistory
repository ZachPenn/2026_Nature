length(unique(units$Animal[units$Sex=='M' & units$Group=='S']))
length(unique(units$Animal[units$Sex=='M' & units$Group=='NS']))
length(unique(units$Animal[units$Group=='NS']))
length(unique(units$Animal[units$Group=='S']))
units$class
sum(units$class=='responsive')

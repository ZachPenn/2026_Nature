}
dns_trc$Cz[is.na(dns_trc$Cz)] = 0
dns_trc$AnimalXunit = droplevels(interaction(dns_trc$Animal, dns_trc$unit_id))
dns_trc_mean = summarise_at(
.tbl = group_by(dns_trc, novs_response, relative_time),

.vars = c('Cz')
)
p.ns_trc = ggplot(
data = dns_trc_mean,
aes(x=relative_time,
y = mean,
group = novs_response,
color = novs_response,
fill = novs_response
))
#Define plot specific parameters
p.ymin = -1
p.ymax = 3
p.yint = 1
p.breaks = seq(p.ymin,p.ymax,p.yint)
#Create plot
p.ns_trc  +
geom_rect(
aes(xmin=300,xmax=330,ymin=-1,ymax=3), fill='gray25',color=NA
) +
geom_ribbon(
stat="identity",
aes(
ymin = mean - sem,
ymax = mean + sem
),
size =.3, # p.line.data.size,
alpha = .9,
) +
geom_vline(xintercept = 300, linetype='dashed') +
#facet_grid(cols=vars(novs_response)) +
#facet_grid(vars(novs_response),vars(Group)) +
scale_color_manual(values=c('gray70','red','blue')) +
scale_fill_manual(values=c('gray70','red','blue')) +
coord_cartesian(ylim=c(p.ymin,p.ymax)) +
scale_y_continuous(breaks=p.breaks, labels = p.breaks, expand = c(0, 0)) +
scale_x_continuous(breaks=seq(0,600,100), labels=seq(-30,30,10)) +
ggtitle("Novel Stressor\n Response") + ylab("Fitted Calcium (z)") + xlab("Stimulus Onset (sec)") +
p.basetheme +
theme(
axis.text.x= element_text(angle = -0),
legend.position =  c(.15,.9),
strip.background = element_blank(),
strip.text = element_blank(),
plot.margin = unit(c(1,2,.1,2), "cm") #(top,right,bottom,left)
)

y = "calcium (z)"
) +
p$theme$base +
p$theme$specs +
theme(
legend.position = c(.175, .9),
legend.key.size = unit(.5, 'cm'),
panel.spacing.x = unit(.25,'cm'),
) +
force_panelsizes(
rows = p$dim$panel_h,
cols = unit(1., "in")
)

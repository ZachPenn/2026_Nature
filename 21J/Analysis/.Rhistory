#Create base layer from group level data
P.sefltest = ggplot(
data = sefltest.stats,
aes(x = Virus,
y = freezing_mean,
fill = Virus))
#Define plot specific parameters
p.ymin = 0
p.ymax = 50
p.yint = 10
p.breaks = seq(p.ymin,p.ymax,p.yint)
#Create plot
P.sefltest  +
geom_crossbar(
stat = "identity",
position = position_dodge(),
linewidth = p$linesize$error,
colour = "black",
aes(ymin = freezing_mean - freezing_sem,
ymax = freezing_mean + freezing_sem),
width = p$width$bar,
show.legend = FALSE) +
geom_jitter(
data = sefltest,
aes(x = Virus,
y = freezing),
width = p$width$bar * p$width$jitter,
height = 0,
shape = p$points$ind$shape,
size = p$points$ind$size,
colour = 'black',
fill = NA,
alpha = p$points$ind$alpha,
show.legend=FALSE
) +
scale_fill_manual(values=p$cols$fill) +
coord_cartesian(ylim=c(p.ymin,p.ymax)) +
scale_y_continuous(breaks=p.breaks, labels = p.breaks, expand = c(0, 0)) +
labs(
x = "",
y = "% Freezing"
) +
p$theme$base +
p$theme$specs +
theme(
legend.position = c(1,1),
axis.text.x = element_text(angle = -45, hjust=0)
) +
force_panelsizes(
rows = p$dim$panel_h,
cols = p$dim$panel_w, #unit(1.75, 'in')
)

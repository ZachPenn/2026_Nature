saveplot(filename = paste(f_pfx,'_',"SEFLtest", p$savetype, sep = ''))
}
sefltest.anova = ezANOVA(
data = sefltest,
dv = freezing,
wid = Animal,
between = .(Virus),
type = 3,
white.adjust = TRUE
)
sefltest.anova
